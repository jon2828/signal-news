{
  "_comment": "Signal pipeline configuration. pipeline_enabled=false is the one-click kill switch: the workflow and every script check it first and exit without posting. The edit model must differ from the write model (independent check).",
  "pipeline_enabled": true,
  "provider_chain": [
    "nvidia",
    "groq",
    "openrouter"
  ],
  "env_keys": {
    "nvidia": "NVIDIA_API_KEY",
    "groq": "GROQ_API_KEY",
    "openrouter": "OPENROUTER_API_KEY"
  },
  "models": {
    "triage": {
      "groq": "qwen/qwen3.8-27b",
      "openrouter": "nvidia/nemotron-3.5-lightning:free",
      "nvidia": "moonshotai/kimi-k3"
    },
    "write": {
      "groq": "openai/gpt-oss-120b",
      "openrouter": "qwen/qwen3.8-27b:free",
      "nvidia": "moonshotai/kimi-k3"
    },
    "edit": {
      "groq": "openai/gpt-oss-120b",
      "openrouter": "qwen/qwen3.8-27b:free",
      "nvidia": "moonshotai/kimi-k3"
    }
  },
  "caps": {
    "posts_per_day": 2,
    "posts_per_run": 2,
    "min_triage_score": 7,
    "max_words_per_post": 1000
  },
  "fetch": {
    "timeout_seconds": 20,
    "max_bytes_per_feed": 2000000,
    "user_agent": "Mozilla/5.0 (compatible; SignalBot/1.0; +https://github.com/jon/signal-news)"
  },
  "triage": {
    "prompt_file": "prompts/triage.md",
    "score_scale": "1-10, 10 = market-moving or frontier-shifting, 7+ = publishable"
  },
  "write": {
    "prompt_file": "prompts/write.md"
  },
  "edit": {
    "prompt_file": "prompts/edit.md"
  },
  "lint": {
    "script": "scripts/lint.py",
    "max_hits_per_post": 2
  },
  "temperature": {
    "triage": 0.0,
    "write": 0.2,
    "edit": 0.0
  },
  "schedule_cron_utc": [
    "0 6 * * *",
    "0 18 * * *"
  ],
  "job_chain": {
    "edit": [
      "groq",
      "nvidia",
      "openrouter"
    ]
  },
  "paid_options": {
    "_comment": "Inert until you add a paid key or flip a slug into the live 'models' section. To use: 1) add the key to ~/.hermes/.env or repo secrets, 2) set the model slug in 'models', 3) optionally reorder provider_chain / job_chain. Billing is per-token except Cloudflare Workers Paid ($5/mo flat, 10K free neurons/day still included).",
    "models": {
      "nvidia": {
        "write": "z-ai/glm-5.3",
        "triage": "moonshotai/kimi-k3",
        "edit": "deepseek-ai/deepseek-v4.1-flash"
      },
      "groq": {
        "write": "openai/gpt-oss-120b",
        "triage": "openai/gpt-oss-120b",
        "edit": "openai/gpt-oss-120b"
      },
      "openrouter": {
        "write": "openai/gpt-oss-120b",
        "triage": "openai/gpt-oss-120b",
        "edit": "openai/gpt-oss-120b"
      },
      "cloudflare": {
        "write": "@cf/zai-org/glm-5.3",
        "triage": "@cf/moonshotai/kimi-k2.7-code",
        "edit": "@cf/deepseek-ai/deepseek-v4-pro-0813"
      }
    },
    "upgrade_ladder": [
      "1. Groq pay-per-token (~$1/mo for the whole pipeline) \u2014 removes every rate limit",
      "2. Cloudflare Workers Paid ($5/mo flat) \u2014 unlocks glm-5.3 / kimi-k2.7 / deepseek-v4 on Workers AI, 10K free neurons/day still included",
      "3. Cloudflare Pro ($20/mo) \u2014 not needed; bandwidth is already free"
    ]
  },
  "site_base_url": "https://unspentthoughts.com"
}
